// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ AUTH (NextAuth / Auth.js compatible) ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  committee     Committee
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Last time the user opened the notification bell / activity feed. Drives the
  // bell's unread indicator: any ActivityLogEntry newer than this is "unseen".
  // Null until they first open it (treated as "everything is unseen").
  lastViewedActivityAt DateTime?

  // The role template this user was originally assigned. Persisted so the
  // permissions UI can label deviations against the user's OWN template and
  // reset back to it, rather than inferring a template by scanning all of them.
  roleTemplateId String?
  roleTemplate   RoleTemplate? @relation(fields: [roleTemplateId], references: [id])

  accounts              Account[]
  sessions              Session[]
  permissions           UserPermission[]
  activityLogs          ActivityLogEntry[]
  sentInvites           AdminTransferInvite[] @relation("InviteInitiator")
  phaseOneScoresGiven   PhaseOneScore[]
  emailLogsSent         EmailLog[]
  interviewSlotsEntered InterviewSlot[]
  panelSeatsClaimed     PanelSeat[]
  interviewNotesClosed  InterviewNote[]
  campaignLeadsHeld     CampaignLead[]        @relation("CampaignLeadHolder")
  campaignLeadsAssigned CampaignLead[]        @relation("CampaignLeadAssignedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ PERMISSION SYSTEM ============

enum PermissionKey {
  VIEW_FULL_POOL
  CONFIGURE_SCREENING
  SCREEN_PHASE1
  ENTER_TECHNICAL_SCORE
  ENTER_INTERVIEW_SLOT
  CLAIM_PANEL_SEAT
  EDIT_OWN_INTERVIEW_NOTES
  ENTER_FINAL_DECISION
  MANAGE_CAPACITY
  IMPORT_APPLICANTS
  MANAGE_ACCOUNTS
  MANAGE_CAMPAIGNS
  SEND_EMAILS
  VIEW_CAMPAIGN_HISTORY
  VIEW_ACTIVITY_LOG
}

enum Committee {
  MKT
  TM
  EER
}

enum RoleTemplateName {
  TM_REVIEWER
  TECHNICAL_SCORER
  COMMITTEE_REPRESENTATIVE
  TM_LEAD
}

model RoleTemplate {
  id          String                   @id @default(cuid())
  name        RoleTemplateName         @unique
  description String?
  permissions RoleTemplatePermission[]
  users       User[]
}

model RoleTemplatePermission {
  id             String        @id @default(cuid())
  roleTemplateId String
  permission     PermissionKey

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)

  @@unique([roleTemplateId, permission])
}

// Where a UserPermission row came from. MANUAL is any direct admin action
// (Permission Management toggle/bulk-set, template application, admin
// transfer). LEAD_ROLE means it exists solely because the holder currently
// holds a CampaignLead role that auto-grants it (e.g. Technical Lead ->
// ENTER_TECHNICAL_SCORE) — such a row is auto-revoked when that lead
// assignment ends, unless a manual toggle has since overridden it back to
// MANUAL (see togglePermission/bulkSetPermission in admin/permissions/actions.ts).
enum PermissionSource {
  MANUAL
  LEAD_ROLE
}

// The actual source of truth for what a user can do. Permissions are global
// flags; where data must be scoped to a committee, that comes from the
// holder's own User.committee, not from the permission row.
model UserPermission {
  id         String           @id @default(cuid())
  userId     String
  permission PermissionKey
  grantedBy  String?
  grantedAt  DateTime         @default(now())
  source     PermissionSource @default(MANUAL)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

// ============ ADMIN HANDOFF ============

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model AdminTransferInvite {
  id           String       @id @default(cuid())
  invitedEmail String
  token        String       @unique
  status       InviteStatus @default(PENDING)
  initiatedBy  String
  createdAt    DateTime     @default(now())
  respondedAt  DateTime?

  initiator User @relation("InviteInitiator", fields: [initiatedBy], references: [id])
}

// ============ ACTIVITY LOG ============

model ActivityLogEntry {
  id         String   @id @default(cuid())
  actorId    String
  actionType String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}

// ============ MINIMAL CAMPAIGN + APPLICANT (full fields in Stage 3) ============

model Campaign {
  id        String   @id @default(cuid())
  name      String
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Set when Phase 1 selection is committed (applicant statuses written to
  // SHORTLISTED / REJECTED_PHASE1). Null until then. Non-null is what makes the
  // selection page treat further recalculation/finalization as a risk rather
  // than a routine action — by that point applicants may already be emailed.
  phaseOneFinalizedAt DateTime?

  // GDG Day logistics, interpolated into the Phase 1 acceptance email. Kept on
  // the campaign (not hardcoded in the template like last year's version) so the
  // date/time/location can differ per recruitment cycle. Null until the TM Lead
  // sets them on the selection page — required before acceptance emails send.
  gdgDayDateTime DateTime?
  gdgDayLocation String?

  // Where applicants book their interview slot — the link both booking emails
  // send them to. Per-campaign rather than hardcoded in the templates, since the
  // club regenerates the short link each recruitment cycle. Null until someone
  // sets it on the Interviews page; required before either booking email sends.
  interviewCalendarLink String?

  // Set when the final decision meeting is signed off — every applicant has been
  // Accepted or Rejected and nobody is left SHORTLISTED/PENDING. Null until then.
  // Non-null is what makes the dashboard treat further decision changes as a
  // deliberate re-opening rather than routine, the same way phaseOneFinalizedAt
  // guards the Phase 1 selection page.
  finalDecisionCompletedAt DateTime?

  // External destinations interpolated into the two final-result emails. Kept
  // per-campaign, like interviewCalendarLink, so each field can still be
  // overridden per cycle from the Configuration page — but they split into two
  // groups:
  //   - acceptanceFormLink: genuinely regenerated every cycle (a fresh Google
  //     Form), so a hardcoded/defaulted value would silently mail a stale form.
  //     Null until someone sets it; the batch refuses to send without it.
  //   - gdgcProgramLink / gdgcPlatformLink / discordInviteLink: the club's own
  //     stable destinations, which rarely change year to year. Defaulted below
  //     so a brand-new campaign (or the first-ever setup) starts pre-filled
  //     instead of forcing someone to retype the same three URLs every time —
  //     still freely editable/clearable on the Configuration page afterwards.
  acceptanceFormLink String?
  gdgcProgramLink    String? @default("https://developers.google.com/community")
  gdgcPlatformLink   String? @default("https://gdg.community.dev/gdg-on-campus-higher-institute-of-applied-science-and-technology-sousse-tunisia/")
  discordInviteLink  String? @default("https://discord.com/invite/46WDzCFkBT")

  applicants          Applicant[]
  phaseOneQuestions   PhaseOneQuestion[]
  phaseOneConfig      PhaseOneConfig?
  emailLogs           EmailLog[]
  committeeCapacities CommitteeCapacity[]
  leads               CampaignLead[]
}

// One of the four appointable per-campaign lead titles. MKT/EER/Club Lead are
// currently just a tracked title with no auto-granted capabilities — only
// TECHNICAL_LEAD drives the ENTER_TECHNICAL_SCORE auto-grant/auto-revoke (see
// assignCampaignLead in the leads config actions).
enum LeadRole {
  MKT_LEAD
  EER_LEAD
  CLUB_LEAD
  TECHNICAL_LEAD
}

// Who currently holds each of the four lead titles for a campaign. Reassigning
// a role updates the existing row's userId (see the @@unique below) rather
// than creating a second row — there is exactly one holder per (campaign,
// role) at a time, same "one holder" shape as the sole Administrator, just
// scoped to a campaign instead of global.
model CampaignLead {
  id           String   @id @default(cuid())
  campaignId   String
  role         LeadRole
  userId       String
  assignedAt   DateTime @default(now())
  assignedById String

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation("CampaignLeadHolder", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User     @relation("CampaignLeadAssignedBy", fields: [assignedById], references: [id])

  @@unique([campaignId, role])
}

// How many seats a committee is recruiting for on one campaign. One row per
// (campaign, committee); the @@unique is what the Configuration form upserts
// against.
//
// Only the TARGET lives here. The running accepted count is deliberately not
// stored — it is counted live off Applicant (campaignId + assignedCommittee +
// status ACCEPTED) wherever it's shown, the same reasoning as InterviewNote's
// AVG: a stored counter drifts the moment a status changes by any path that
// forgets to update it, and a live count cannot.
model CommitteeCapacity {
  id         String    @id @default(cuid())
  campaignId String
  committee  Committee
  target     Int

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, committee])
}

enum ApplicantStatus {
  SUBMITTED
  SHORTLISTED
  REJECTED_PHASE1
  INVITED_GDG_DAY
  INTERVIEW_SCHEDULED
  ACCEPTED
  PENDING
  REJECTED_FINAL
}

model Applicant {
  id                 String          @id @default(cuid())
  campaignId         String
  fullName           String
  email              String
  isIssatsoStudent   Boolean
  preferredCommittee Committee
  assignedCommittee  Committee?
  status             ApplicantStatus @default(SUBMITTED)
  rawFormData        Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  campaign       Campaign        @relation(fields: [campaignId], references: [id])
  phaseOneScores PhaseOneScore[]
  phaseOneResult PhaseOneResult?
  emailLogs      EmailLog[]
  interviewSlot  InterviewSlot?
  interviewPanel InterviewPanel?
  interviewNote  InterviewNote?

  @@unique([campaignId, email])
}

// ============ PHASE 1 SCORING ============

enum PhaseOneClassification {
  PENDING // scoring not yet complete for this applicant
  AUTO_ACCEPT
  AUTO_REJECT
  TO_DISCUSS
  MANUAL_ACCEPT // TM team resolved a TO_DISCUSS case to accept
  MANUAL_REJECT // TM team resolved a TO_DISCUSS case to reject
}

model PhaseOneQuestion {
  id                      String  @id @default(cuid())
  campaignId              String
  text                    String
  coefficient             Float
  noteScale               Float[] // e.g. [0, 0.5, 1] or [0, 0.25, 0.5, 0.75, 1]
  order                   Int
  isActive                Boolean @default(true)
  requiresTechnicalScorer Boolean @default(false)
  // true ONLY for the "Technical Skills" question — gates it to
  // ENTER_TECHNICAL_SCORE holders instead of SCREEN_PHASE1 holders
  sourceField             String?
  // Exact CSV/rawFormData key this question reads the applicant's answer
  // from. Null for questions with no single form source (e.g. "Big Yes /
  // Big No", a reviewer judgment call, not read from the form).

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scores   PhaseOneScore[]

  @@unique([campaignId, order])
}

model PhaseOneScore {
  id          String   @id @default(cuid())
  applicantId String
  questionId  String
  value       Float
  scoredById  String
  scoredAt    DateTime @default(now())

  applicant Applicant        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  question  PhaseOneQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  scoredBy  User             @relation(fields: [scoredById], references: [id])

  @@unique([applicantId, questionId])
}

model PhaseOneResult {
  id             String                 @id @default(cuid())
  applicantId    String                 @unique
  weightedTotal  Float?
  rank           Int?
  classification PhaseOneClassification @default(PENDING)
  updatedAt      DateTime               @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model PhaseOneConfig {
  id              String @id @default(cuid())
  campaignId      String @unique
  rejectThreshold Float?
  targetCount     Int?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ============ EMAIL LOG ============

// One row per outbound templated email send *attempt*. Both SENT and FAILED are
// recorded so a batch can report a summary and, on a later run, skip anyone
// already emailed for a given template+campaign (duplicate-send prevention on
// the Phase 1 Selection page keys off these rows).
model EmailLog {
  id           String   @id @default(cuid())
  applicantId  String
  campaignId   String
  templateKey  String // e.g. "PHASE1_REJECTION", "PHASE1_ACCEPTANCE"
  status       String // "SENT" or "FAILED"
  errorMessage String?
  sentAt       DateTime @default(now())
  sentById     String

  applicant Applicant @relation(fields: [applicantId], references: [id])
  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  sentBy    User      @relation(fields: [sentById], references: [id])
}

// ============ INTERVIEW SCHEDULING ============

// One row per shortlisted applicant invited to book an interview. Created empty
// (scheduledTime null) at booking-invite send time, then filled in by hand from
// the external booking calendar — the club books through a bit.ly calendar link,
// so nothing writes scheduledTime automatically. A null scheduledTime therefore
// means "hasn't booked yet", which is exactly who the reminder email targets.
model InterviewSlot {
  id            String    @id @default(cuid())
  applicantId   String    @unique
  scheduledTime DateTime?
  room          String?
  enteredById   String?
  enteredAt     DateTime?

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  enteredBy User?     @relation(fields: [enteredById], references: [id])
}

// The interview panel for one applicant. Holds no fields of its own beyond the
// applicant link — "who is on the panel" is entirely the set of claimed seats.
model InterviewPanel {
  id          String @id @default(cuid())
  applicantId String @unique

  applicant Applicant   @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  seats     PanelSeat[]
}

// One seat per committee on a panel, claimed by at most one user. The
// @@unique([panelId, committee]) is what enforces "one seat per committee per
// panel"; an unclaimed seat is a row with claimedById still null.
model PanelSeat {
  id          String    @id @default(cuid())
  panelId     String
  committee   Committee
  claimedById String?
  claimedAt   DateTime?

  panel     InterviewPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  claimedBy User?          @relation(fields: [claimedById], references: [id])

  @@unique([panelId, committee])
}

// The panel's scoring sheet for one applicant. "Jury" (who sat on the panel) is
// already represented by InterviewPanel/PanelSeat's claimedBy, so there is no
// separate field for it here. The AVG shown in the UI is computed on read as the
// mean of the 7 non-null scores — deliberately not stored, so it can never drift
// out of sync with the scores it summarizes.
model InterviewNote {
  id               String   @id @default(cuid())
  applicantId      String   @unique
  personality      Float?
  communication    Float?
  motivation       Float?
  creativity       Float?
  problemSolving   Float?
  stressManagement Float?
  teamWork         Float?
  remarks          String?
  updatedAt        DateTime @updatedAt

  // Closing an interview note locks it: once closedAt is set, only MANAGE_ACCOUNTS
  // holders may view or edit it (see canViewInterviewNote / canEditInterviewNote).
  // A MANAGE_ACCOUNTS holder can reopen it, clearing both fields.
  closedAt   DateTime?
  closedById String?

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  closedBy  User?     @relation(fields: [closedById], references: [id])
}
